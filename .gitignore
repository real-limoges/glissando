/target
.DS_Store
# `output/*`, not `output/`: git cannot re-include a file inside an excluded
# directory, and the gzipped summary is the committed mgcv fixture.
benchmark/output/*
!benchmark/output/comparison_summary.json.gz
benchmark/target/
.idea/
CLAUDE.md
.claude

.venv/
.venv-prepush/
*.pyc
__pycache__/

# CI build outputs (maturin wheels, coverage report).
dist/
lcov.info

# Accidental root-level npm scaffolding; the published npm package is pkg/.
/package.json
/package-lock.json

# docs/: only the public reference/ tree is tracked.
docs/*
!docs/reference/
