#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PASS="\033[0;32m✓\033[0m"
FAIL="\033[0;31m✗\033[0m"
BOLD="\033[1m"
RESET="\033[0m"

failed=()

run_check() {
  local name="$1"
  shift
  printf "${BOLD}%-30s${RESET}" "$name"
  if output=$("$@" 2>&1); then
    printf " ${PASS}\n"
  else
    printf " ${FAIL}\n"
    echo "$output" | sed 's/^/    /'
    failed+=("$name")
  fi
}

echo ""
echo "${BOLD}pre-push checks${RESET}"
echo "───────────────────────────────"

run_check "fmt"              cargo fmt --check
run_check "clippy"           cargo clippy --workspace -- -D warnings
run_check "audit-duplicates" ./scripts/audit-duplicates.sh
run_check "test (openblas)"  cargo test
run_check "test (pure-rust)" cargo test --no-default-features --features pure-rust
run_check "check-wasm"       cargo check --target wasm32-unknown-unknown --no-default-features --features wasm
run_check "doctest"          cargo test --doc --features openblas,parallel,serialization

echo "───────────────────────────────"

if [ ${#failed[@]} -gt 0 ]; then
  printf "${FAIL} ${#failed[@]} check(s) failed: %s\n" "${failed[*]}"
  echo "Push aborted. Fix the above errors or use --no-verify to skip."
  exit 1
fi

printf "${PASS} All checks passed.\n"
echo ""
